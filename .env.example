# CYNEXIS — Environment Configuration Template
# Copy this file to .env and modify values as needed.
# NEVER commit .env to git — it may contain secrets.

# ============================================================
# IDENTITY
# ============================================================
CYNEXIS_NAME=CYNEXIS
ROBOT_ID=cynexis-001
ENVIRONMENT=development

# ============================================================
# API SERVER
# ============================================================
API_HOST=0.0.0.0
API_PORT=8000

# ============================================================
# FEATURE TOGGLES
# ============================================================
CAMERA_ENABLED=true
VOICE_ENABLED=true
AI_ENABLED=true
MOCK_MODE=true

# ============================================================
# PATHS
# ============================================================
DATABASE_PATH=./Database/cynexis.db
PHOTO_PATH=./Photos
VIDEO_PATH=./Recordings
LOG_PATH=./Logs

# ============================================================
# SYNC
# ============================================================
SYNC_ENABLED=false
SYNC_API_URL=

# ============================================================
# SERIAL (ESP32) — legacy
# ============================================================
SERIAL_PORT=
SERIAL_BAUD=115200

# ============================================================
# ESP32 COMMUNICATION
# ============================================================
# Set this to your ESP32 gateway COM port (e.g. COM5, /dev/ttyUSB0)
ESP32_SERIAL_PORT=
ESP32_BAUD_RATE=115200

# Motor safety: set to true ONLY after serial communication is verified
HARDWARE_MOTORS_ENABLED=false

# Heartbeat and timeout configuration
HEARTBEAT_INTERVAL_S=1.0
HEARTBEAT_TIMEOUT_S=3.0
COMMAND_TIMEOUT_S=2.0
MAX_RETRIES=3

# ============================================================
# TEXT-TO-SPEECH (KOKORO TTS)
# ============================================================
CYNEXIS_TTS_PROVIDER=kokoro
CYNEXIS_TTS_VOICE=am_michael
CYNEXIS_TTS_SPEED=1.0
CYNEXIS_TTS_ENABLED=true
CYNEXIS_TTS_PLAY_LOCAL=true
CYNEXIS_TTS_SAVE_LOGS=false
CYNEXIS_TTS_LOG_PATH=./Logs/TTS
